{
  "name": "resort-spot",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start.mjs",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:bump": "npm version --no-git-tag-version",
    "playwright:install": "npx playwright install chromium",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "npm run build && playwright test && playwright test --config playwright.alternative.config.ts",
    "test:e2e:alternative": "npm run build && playwright test --config playwright.alternative.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "check:all": "npm run lint && npm run format:check && npm run test:ci && npm run build"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "fsevents@2.3.2": true
  }
}
